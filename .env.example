# Variables d'environnement de Nova Services.
# Copiez ce fichier en .env.local (jamais versionné) et remplissez les valeurs
# du projet Supabase de DÉVELOPPEMENT. Ne collez jamais une clé ici :
# ce fichier est public.

# --- Supabase (AD-9 : nouvelles clés, région Irlande eu-west-1) ---
# Adresse du projet : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (sb_publishable_…), utilisée côté serveur avec la session
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…), lue uniquement dans lib/server/
SUPABASE_SECRET_KEY=
# Adresse de connexion PostgreSQL (pooler, mode session), pour db:push et les tests de sécurité
SUPABASE_DB_URL=
# « developpement » en local et en CI ; « production » sur Netlify. Les tests refusent tout autre valeur que « developpement ».
SUPABASE_ENVIRONNEMENT=

# --- Emails (AD-13, lus uniquement dans lib/server/) ---
RESEND_API_KEY=
# Adresses autorisées à recevoir des emails en mode démonstration, séparées par des virgules.
# Vide : aucun envoi. « * » : toutes les adresses (production, domaine vérifié dans Resend).
EMAILS_AUTORISES=
# Adresse d'expédition ; vide : onboarding@resend.dev (Resend sans domaine)
EMAIL_EXPEDITEUR=

# --- Empreintes HMAC des IP et emails (AD-14, lu uniquement dans lib/server/) ---
# Longue chaîne aléatoire (par exemple 64 caractères hexadécimaux). Obligatoire en production :
# sans elle, le dépôt est refusé. En développement et en CI, si elle est vide, une clé aléatoire
# est tirée au démarrage du serveur (avertissement dans la console).
HMAC_SECRET=

# --- Tests seulement (story 1.8) ---
# « 1 » : l'en-tête x-nova-ip-test remplace l'adresse IP (chaque test dépose avec sa propre IP).
# Posée par playwright.config.ts pour le serveur qu'il lance. Jamais sur Netlify, jamais dans .env.local.
IP_DE_TEST_AUTORISEE=

# --- Suivi des erreurs Sentry, région UE (AD-14) ---
# DSN du projet : Project Settings > Client Keys (DSN). Vide : Sentry désactivé.
# Actif aussi en développement dès qu'il est rempli (environnement « developpement »).
NEXT_PUBLIC_SENTRY_DSN=
# Organisation et projet Sentry (identifiants courts), pour l'envoi des cartes du code source
SENTRY_ORG=
SENTRY_PROJECT=
# Jeton d'envoi des cartes du code source : sur Netlify seulement (story 3.1), jamais en local
SENTRY_AUTH_TOKEN=

# --- Version et hébergement (AD-11) ---
# Injectée au build depuis package.json
NEXT_PUBLIC_APP_VERSION=
# Sur Netlify : true
NETLIFY_NEXT_SKEW_PROTECTION=

# --- Comptes de test persistants (story 1.4, développement seulement) ---
# Remplis par npm run comptes:test (mots de passe aléatoires, jamais affichés)
TEST_ADMIN_EMAIL=
TEST_ADMIN_MOT_DE_PASSE=
TEST_COLLAB_EMAIL=
TEST_COLLAB_MOT_DE_PASSE=
