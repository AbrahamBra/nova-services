# Variables d'environnement de Nova Services.
# Copiez ce fichier en .env.local (jamais versionné) et remplissez les valeurs
# du projet Supabase de DÉVELOPPEMENT. Ne collez jamais une clé ici :
# ce fichier est public.

# --- Supabase (AD-9 : nouvelles clés, région Irlande eu-west-1) ---
# Adresse du projet : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (sb_publishable_…), utilisée côté serveur avec la session
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…), lue uniquement dans lib/server/
SUPABASE_SECRET_KEY=
# Adresse de connexion PostgreSQL (pooler, mode session), pour db:push et les tests de sécurité
SUPABASE_DB_URL=
# « developpement » en local et en CI ; « production » sur Netlify. Les tests refusent tout autre valeur que « developpement ».
SUPABASE_ENVIRONNEMENT=

# --- Emails (AD-13, lus uniquement dans lib/server/) ---
RESEND_API_KEY=
# Adresses autorisées à recevoir des emails en mode démonstration, séparées par des virgules
EMAILS_AUTORISES=

# --- Empreintes HMAC des IP et emails (AD-14, lu uniquement dans lib/server/) ---
HMAC_SECRET=

# --- Suivi des erreurs Sentry, région UE (AD-14) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Version et hébergement (AD-11) ---
# Injectée au build depuis package.json
NEXT_PUBLIC_APP_VERSION=
# Sur Netlify : true
NETLIFY_NEXT_SKEW_PROTECTION=
