{
  "name": "nova-services",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verifier": "npm run lint && npm run typecheck",
    "db:push": "node scripts/db-push.mjs",
    "secrets:github": "node scripts/secrets-github.mjs",
    "admin:creer": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/premier-admin.ts",
    "comptes:test": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/comptes-de-test.ts",
    "donnees:remplir": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/donnees.ts remplir",
    "donnees:vider": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/donnees.ts vider",
    "journal": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/journal.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "~11.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "~2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "~6.37.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "~4.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/env": "16.4.4",
    "@playwright/test": "~1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "pg": "^8.23.1",
    "supabase": "~3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "~5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
