        "jsonBody": "={{ JSON.stringify({\n  from: 'Nova Services <onboarding@resend.dev>',\n  to: [$('Lire la catégorie').item.json.service_notifie],\n  subject: 'Nouvelle demande ' + $('Lire la catégorie').item.json.categorie + ' — ' + $('Lire la catégorie').item.json.nom,\n  text: 'Bonjour,\\n\\nUne nouvelle demande est arrivée chez Nova Services.\\n\\n'\n    + 'Catégorie (proposée par l\\'IA) : ' + $('Lire la catégorie').item.json.categorie + '\\n'\n    + 'Reçue le : ' + $('Lire la catégorie').item.json.date_reception + '\\n'\n    + 'Nom : ' + $('Lire la catégorie').item.json.nom + '\\n'\n    + 'Email : ' + $('Lire la catégorie').item.json.email + '\\n\\n'\n    + 'Message :\\n' + $('Lire la catégorie').item.json.message + '\\n\\n'\n    + ($('Lire la catégorie').item.json.remarque ? 'Remarque : ' + $('Lire la catégorie').item.json.remarque + '\\n\\n' : '')\n    + 'Trace : exécution N8N n° ' + $('Lire la catégorie').item.json.execution\n}) }}",
